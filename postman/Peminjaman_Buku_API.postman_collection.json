{
  "info": {
    "_postman_id": "peminjaman-buku-api-001",
    "name": "Peminjaman Buku API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.0.0"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Anggota - List (paginate)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/api/anggota?per_page=10",
          "host": ["{{base_url}}"],
          "path": ["api","anggota"],
          "query": [ { "key": "per_page", "value": "10" } ]
        }
      }
    },
    {
      "name": "Anggota - Search",
      "request": {
        "method": "GET",
        "header": [ { "key": "Accept", "value": "application/json" } ],
        "url": { "raw": "{{base_url}}/api/anggota/search?search=joko&per_page=5", "host": ["{{base_url}}"], "path": ["api","anggota","search"], "query": [ { "key": "search", "value": "joko" }, { "key": "per_page", "value": "5" } ] }
      }
    },
    {
      "name": "Anggota - Show",
      "request": {
        "method": "GET",
        "header": [ { "key": "Accept", "value": "application/json" } ],
        "url": { "raw": "{{base_url}}/api/anggota/1", "host": ["{{base_url}}"], "path": ["api","anggota","1"] }
      }
    },
    {
      "name": "Anggota - Create",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Accept", "value": "application/json" } ],
        "body": { "mode": "raw", "raw": "{\n  \"nama\": \"Joko Susilo\",\n  \"alamat\": \"Jl. Contoh 1\",\n  \"nomor\": \"08123456789\"\n}" },
        "url": { "raw": "{{base_url}}/api/anggota", "host": ["{{base_url}}"], "path": ["api","anggota"] }
      }
    },
    {
      "name": "Peminjaman - List (paginate)",
      "request": {
        "method": "GET",
        "header": [ { "key": "Accept", "value": "application/json" } ],
        "url": { "raw": "{{base_url}}/api/peminjaman?per_page=10&anggota_id=1", "host": ["{{base_url}}"], "path": ["api","peminjaman"], "query": [ { "key": "per_page", "value": "10" }, { "key": "anggota_id", "value": "1" } ] }
      }
    },
    {
      "name": "Peminjaman - Search",
      "request": {
        "method": "GET",
        "header": [ { "key": "Accept", "value": "application/json" } ],
        "url": { "raw": "{{base_url}}/api/peminjaman/search?search=ID123&per_page=5", "host": ["{{base_url}}"], "path": ["api","peminjaman","search"], "query": [ { "key": "search", "value": "ID123" }, { "key": "per_page", "value": "5" } ] }
      }
    },
    {
      "name": "Peminjaman - Create",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Accept", "value": "application/json" } ],
        "body": { "mode": "raw", "raw": "{\n  \"anggota_id\": 1,\n  \"buku_id\": 2,\n  \"tanggal_pinjam\": \"2026-02-11\",\n  \"tanggal_kembali\": \"2026-02-18\"\n}" },
        "url": { "raw": "{{base_url}}/api/peminjaman", "host": ["{{base_url}}"], "path": ["api","peminjaman"] }
      }
    },
    {
      "name": "Peminjaman - Update",
      "request": {
        "method": "PUT",
        "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Accept", "value": "application/json" } ],
        "body": { "mode": "raw", "raw": "{\n  \"tanggal_kembali\": \"2026-02-20\"\n}" },
        "url": { "raw": "{{base_url}}/api/peminjaman/1", "host": ["{{base_url}}"], "path": ["api","peminjaman","1"] }
      }
    },
    {
      "name": "Peminjaman - Delete",
      "request": {
        "method": "DELETE",
        "header": [ { "key": "Accept", "value": "application/json" } ],
        "url": { "raw": "{{base_url}}/api/peminjaman/1", "host": ["{{base_url}}"], "path": ["api","peminjaman","1"] }
      }
    }
  ]
}
